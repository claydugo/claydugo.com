{
	"$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/*.html",
			"**/*.css",
			"**/*.json",
			"**/*.js",
			"**/*.mjs",
			"!untappd-data-parser",
			"!beerstats/stats.json"
		],
		"maxSize": 1048576
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"preset": "recommended"
			},
			"suspicious": {
				"preset": "recommended"
			},
			"complexity": {
				"preset": "recommended",
				"noImportantStyles": "off"
			},
			"performance": {
				"preset": "recommended"
			},
			"security": {
				"preset": "recommended"
			},
			"a11y": {
				"preset": "recommended"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"quoteStyle": "double"
		}
	},
	"html": {
		"formatter": {
			"enabled": true,
			"indentStyle": "tab"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
